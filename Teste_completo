# REDUÇÃO SEREP
# ============================================================

def SEREP (Kg, Mg, n_dof, mestre):

    mestre = np.array(mestre)-1
    gdl = np.arange(n_dof)  
    slave = np.delete(gdl, mestre) 
   
    K_mm = Kg[np.ix_(mestre, mestre)] 
    M_mm = Mg[np.ix_(mestre, mestre)]
    K_ss = Kg[np.ix_(slave, slave)] 
    M_ss = Mg[np.ix_(slave, slave)] 
    K_ms = Kg[np.ix_(mestre, slave)]
    K_sm= np.transpose(K_ms)
    M_ms = Mg[np.ix_(mestre, slave)]
    M_sm = np.transpose(M_ms)

    K_serep = np.block([[K_mm, K_ms], [K_sm, K_ss]])
    M_serep = np.block([[M_mm, M_ms], [M_sm, M_ss]])

    n_modos = len(mestre)

    autovalor, PHI = eigh(Kg, Mg)

    PHI = PHI [:, :n_modos]
    PHI_m = PHI[mestre, :]
    PHI_s = PHI[slave, :]
    
    ts = PHI_s@np.linalg.pinv(PHI_m)
    I=np.eye(ts.shape[1])
    Ts=np.vstack((I,ts))
    Kr=np.transpose(Ts)@K_serep@Ts
    Mr=np.transpose(Ts)@M_serep@Ts

    return Kr, Mr

# Número de GDL por nó
ndof_por_no = 6

# Arquivos exportados do Abaqus
arquivo_K = '2_5_STIF1_label.mtx'
arquivo_M = '2_5_MASS1_label.mtx'

# Lendo matrizes
Kg = ler_matriz_abaqus(arquivo_K, ndof_por_no)
Mg = ler_matriz_abaqus(arquivo_M, ndof_por_no)


# Escolha apenas os NÓS
n_nos = Kg.shape[0] // ndof_por_no
n_mestre = list(range(1,n_nos+ 1, 10))

# Conversão automática para TODOS os GDLs do nó
mestre = converter_nos_para_gdl(n_mestre, ndof_por_no)

print('GDLs mestres utilizados:')
print(mestre)


# REDUÇÃO
n_dof = Kg.shape[0]
Kr_guyan, Mr_guyan = guyan(Kg, Mg, n_dof, mestre)
Kr_serep, Mr_serep = SEREP(Kg, Mg, n_dof, mestre)


# FREQUÊNCIAS NATURAIS
fn_mestre = np.sqrt(modal(Kg, Mg))
fn_guyan = np.sqrt(modal(Kr_guyan, Mr_guyan))
fn_serep = np.sqrt(modal(Kr_serep, Mr_serep))

print ('Frequencias naturais do modelo completo:\n', fn_mestre)
print ('Frequencias naturais por Guyan:\n', fn_guyan)
print ('Frequencias naturais por SEREP:\n', fn_serep)


